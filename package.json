{
  "name": "boardly",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time kanban board: React + TypeScript client, Node + TypeScript API with sessions and WebSockets, SQLite storage",
  "workspaces": ["server", "client"],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": { "node": ">=22.13" }
}
